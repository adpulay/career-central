{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:978446946447:log-group:CareerCentralMonitor-dev-*:*"
    },
    {
      "Sid": "MonitorObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::careercentralmonitor-dev-*/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "978446946447"
        }
      }
    },
    {
      "Sid": "MissingObjectsAs404",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::careercentralmonitor-dev-*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "978446946447"
        }
      }
    },
    {
      "Sid": "MonitorTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:978446946447:table/CareerCentralMonitor-dev-*"
    },
    {
      "Sid": "InvokeTick",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": [
        "arn:aws:lambda:us-east-1:978446946447:function:CareerCentralMonitor-dev-*",
        "arn:aws:lambda:us-east-1:978446946447:function:CareerCentralMonitor-dev-*:*"
      ]
    }
  ]
}
