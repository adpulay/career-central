{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyEveryServiceTheFixtureTestDoesNotUse",
      "Effect": "Deny",
      "NotAction": [
        "cloudformation:*",
        "lambda:*",
        "s3:*",
        "dynamodb:*",
        "logs:*",
        "cloudwatch:*",
        "scheduler:*",
        "iam:*",
        "sts:*",
        "kms:*",
        "ecr:*",
        "access-analyzer:*",
        "servicequotas:*",
        "cloudshell:*",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:PutParameter",
        "ssm:DeleteParameter",
        "ssm:DeleteParameters",
        "ssm:DescribeParameters",
        "ssm:AddTagsToResource",
        "ssm:RemoveTagsFromResource",
        "ssm:ListTagsForResource",
        "budgets:*",
        "ce:*",
        "cur:*",
        "billing:*",
        "aws-portal:*",
        "account:*",
        "freetier:*",
        "invoicing:*",
        "payments:*",
        "tax:*",
        "pricing:*",
        "consolidatedbilling:*",
        "notifications:*",
        "notifications-contacts:*",
        "health:*",
        "support:*",
        "trustedadvisor:*",
        "organizations:*",
        "sso:*",
        "sso-directory:*",
        "identitystore:*",
        "tag:*",
        "resource-groups:*",
        "cloudtrail:LookupEvents",
        "cloudtrail:Describe*",
        "cloudtrail:Get*",
        "cloudtrail:List*"
      ],
      "Resource": "*"
    }
  ]
}
