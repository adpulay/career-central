{
  "name": "career-central-infra",
  "private": true,
  "type": "module",
  "description": "Career Central AWS C1 infrastructure (CDK) and Lambda packaging. Synth/test only; nothing here deploys by itself.",
  "engines": {"node": ">=22"},
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "synth": "cdk synth --quiet",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1159.0",
    "@aws-sdk/client-s3": "3.1159.0",
    "aws-cdk": "2.1146.1",
    "aws-cdk-lib": "2.275.0",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1",
    "esbuild": "0.28.2"
  }
}
